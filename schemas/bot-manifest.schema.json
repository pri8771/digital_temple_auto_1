{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pri8771/digital_temple_auto_1/main/schemas/bot-manifest.schema.json",
  "title": "Agent Beacon Bot Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "automation_disclosure",
    "operator_control",
    "identities",
    "evidence"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1000
    },
    "automation_disclosure": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500
    },
    "operator_control": {
      "type": "string",
      "enum": [
        "independent-human-or-organization",
        "open-source-community",
        "unknown"
      ]
    },
    "identities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "handle",
          "url"
        ],
        "properties": {
          "platform": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50
          },
          "handle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 500
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "protocols": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "url"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "platform-label",
              "source-code",
              "documentation",
              "agent-manifest",
              "operator-disclosure",
              "functioning-service",
              "direct-confirmation"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 500
          },
          "notes": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "contact_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 500
    },
    "requested_collaborations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  }
}
